# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/

# Data (large files — download separately)
data/*.npz
data/*.h5ad
data/*.pt
data/*.parquet

# Results: commit the canonical small tables (reproducibility backbone).
# Large intermediate tables can be regenerated by scripts.
# (all current results/*.csv are <12MB and ARE committed)

# LaTeX intermediates
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Local backup of remote result data (45MB); not committed
results/_remote/

# Figure build intermediates and raster previews (regenerate from figures/**/*.py
# and *_assemble.tex; only the vector composites and AI-panel PDFs are tracked)
manuscript/figures/**/*_assemble.pdf
manuscript/figures/**/*.png
# .svg (editable) and .tiff (600 dpi LZW) are production-bundle formats written
# alongside every Fig. 1 panel PDF. They are ~2.8 MB per regeneration and carry
# nothing the tracked PDF does not, so they stay out of git and are rebuilt with
# `python manuscript/figures/fig1/<panel>.py` when a submission bundle is needed.
manuscript/figures/**/*.svg
manuscript/figures/**/*.tiff

# Externally designed panel bundles as delivered (~79 MB of zips and unpacked
# trees). Every panel they contain has been extracted, corrected and adapted
# into manuscript/figures/fig<N>/, which is what the composites build from, and
# their bundled provenance scripts are older than this repository's own. Kept on
# disk for reference only.
manuscript/Figure*_delivery/
manuscript/Figure*_delivery.zip
manuscript/Figure*_refined/
manuscript/Figure*_refined.zip

# Local-only skills toolkit; never commit or publish (kept out of GitHub)
Nature-Paper-Skills/

# Superseded figure panels and the old fig1 snapshot: kept on disk for
# reference, not part of the published artifact (originals are in git history).
manuscript/figures/_superseded/

# external datasets downloaded for screening (never commit)
data_external/
